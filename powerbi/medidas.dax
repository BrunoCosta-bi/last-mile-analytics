-- Criar uma medida por vez no Power BI Desktop.
-- Nome da tabela carregada do SQL: fato_entregas.
Total de Pedidos = COUNTROWS(fato_entregas)
Entregas Concluidas = SUM(fato_entregas[entregue])
Entregas no Prazo = SUM(fato_entregas[no_prazo])
On Time % = DIVIDE([Entregas no Prazo], [Entregas Concluidas])
Taxa Conclusao % = DIVIDE([Entregas Concluidas], [Total de Pedidos])
Entregas Atrasadas = [Entregas Concluidas] - [Entregas no Prazo]
Lead Time Medio (h) = DIVIDE(SUM(fato_entregas[tempo_ciclo_horas]), [Entregas Concluidas])
Atraso Medio das Atrasadas (h) =
    DIVIDE(SUM(fato_entregas[atraso_horas]), [Entregas Atrasadas])
Meta On Time = 0.95
Desvio Meta (p.p.) = ([On Time %] - [Meta On Time]) * 100
On Time Mes Anterior =
    CALCULATE([On Time %], DATEADD(DimCalendario[Date], -1, MONTH))
Variacao On Time (p.p.) = ([On Time %] - [On Time Mes Anterior]) * 100

-- Criar como TABELA CALCULADA (Modelagem > Nova tabela):
DimCalendario =
    ADDCOLUMNS(
        CALENDAR(DATE(2026, 1, 1), DATE(2026, 9, 30)),
        "Ano", YEAR([Date]),
        "Mes", FORMAT([Date], "MMM"),
        "MesAno", FORMAT([Date], "YYYY-MM"),
        "NumeroMes", MONTH([Date])
    )
