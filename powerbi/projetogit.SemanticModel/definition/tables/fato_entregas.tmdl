	partition fato_entregas = m
		mode: import
		source =
				let
				    // No modo EMBUTIDO, o PBIP carrega a base sintética completa sem arquivos locais.
				    BinarioEmbutido = Binary.Decompress(
				    Binary.FromText(
				        Text.Combine({
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
