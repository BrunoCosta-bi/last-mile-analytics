				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            "",
				            ""
				        }, ""),
				        BinaryEncoding.Base64
				    ),
				    Compression.GZip
				),
				    FonteBinaria = if ModoFonte = "Embutido" then BinarioEmbutido
				                   else if ModoFonte = "CSV" then File.Contents(CaminhoCSV)
				                   else null,
				    Dados = if ModoFonte = "SQL" then
				            Sql.Database(ServidorSQL, BancoSQL){[Schema="dbo", Item="fato_entregas"]}[Data]
				        else
				            let
				                DadosCSV = Csv.Document(FonteBinaria,
				                    [Delimiter=",", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				                Cabecalhos = Table.PromoteHeaders(DadosCSV, [PromoteAllScalars=true]),
				                Nulos = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue,
				                    {"data_entrega", "motivo_atraso", "atraso_horas", "tempo_ciclo_horas"}),
				                Flags = Table.TransformColumns(Nulos, {
				                    {"entregue", each Text.From(_) = "1" or Text.Lower(Text.From(_)) = "true", type logical},
				                    {"no_prazo", each Text.From(_) = "1" or Text.Lower(Text.From(_)) = "true", type logical}
				                }),
				                Tipos = Table.TransformColumnTypes(Flags, {
				                    {"id_entrega", type text}, {"data_coleta", type datetime},
				                    {"data_prevista", type datetime}, {"data_entrega", type datetime},
				                    {"cd", type text}, {"uf", type text}, {"cidade", type text},
				                    {"transportadora", type text}, {"status", type text},
				                    {"valor_pedido", type number}, {"peso_kg", type number},
				                    {"tentativas", Int64.Type}, {"motivo_atraso", type text},
				                    {"data_coleta_dia", type date}, {"mes_referencia", type date},
				                    {"atraso_horas", type number}, {"tempo_ciclo_horas", type number}
				                }, "en-US")
				            in
				                Tipos,
				    DataEntregaDia = Table.AddColumn(Dados, "data_entrega_dia",
				        each if [data_entrega] = null then null else Date.From([data_entrega]), type date)
				in
				    DataEntregaDia

	annotation PBI_ResultType = Table

